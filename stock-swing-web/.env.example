NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server-side only. Never expose this value to browser code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY

# GitHub Actions workflow dispatch used by the analysis update button.
GITHUB_ACTIONS_TOKEN=YOUR_FINE_GRAINED_TOKEN
GITHUB_OWNER=YOUR_GITHUB_OWNER
GITHUB_CORE_REPO=stock-swing-core
GITHUB_WORKFLOW_ID=run_daily.yml
GITHUB_REF=main
